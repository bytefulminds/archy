#!/bin/sh
# AppImage entry point. The PyInstaller onedir bundle lives in usr/bin; launch
# its executable, passing through any file argument (so "Open with" and
# `Archy <file>` work). HERE is the mounted AppDir root at runtime.
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
exec "$HERE/usr/bin/Archy/Archy" "$@"
